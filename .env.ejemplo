# Copia este archivo a .env y cambia TODOS los valores.
# Generar un secreto:  python -c 'import secrets; print(secrets.token_urlsafe(50))'

# --- General ---
DJANGO_DEBUG=1

# --- Retales (app principal) ---
RETALES_SECRET_KEY=cambia-esto
RETALES_ALLOWED_HOSTS=localhost,127.0.0.1
# Opcional, necesario si sirves Retales tras HTTPS/dominio propio (ej. https://retales.example.com):
# RETALES_CSRF_TRUSTED_ORIGINS=
RETALES_DB_NAME=retales_db
RETALES_DB_USER=retales_user
RETALES_DB_PASSWORD=cambia-esto

# Superusuario que se crea al arrancar 
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=cambia-esto

# --- Materiales (microservicio) ---
MATERIALES_SECRET_KEY=cambia-esto
# Opcional (por defecto: materiales,localhost,127.0.0.1):
# MATERIALES_ALLOWED_HOSTS=
MATERIALES_DB_NAME=materiales_db
MATERIALES_DB_USER=materiales_user
MATERIALES_DB_PASSWORD=cambia-esto

# --- Comunicación entre servicios ---
SERVICE_TOKEN=cambia-esto
